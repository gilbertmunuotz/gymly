<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Gymly" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/gym_primary</item>
        <item name="colorPrimaryVariant">@color/gym_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/gym_accent</item>
        <item name="colorSecondaryVariant">@color/gym_primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/gym_surface</item>
        <item name="colorOnSurface">@color/gym_text_primary</item>
        <item name="android:colorBackground">@color/gym_background</item>
        <item name="android:statusBarColor">@color/gym_primary_dark</item>
        <item name="android:windowBackground">@color/gym_background</item>
        <item name="materialButtonStyle">@style/Widget.Gymly.Button</item>
    </style>

    <style name="Theme.Gymly.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gym_primary</item>
        <item name="colorPrimaryVariant">@color/gym_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/gym_accent</item>
        <item name="colorSecondaryVariant">@color/gym_primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/gym_surface</item>
        <item name="colorOnSurface">@color/gym_text_primary</item>
        <item name="android:colorBackground">@color/gym_background</item>
        <item name="android:statusBarColor">@color/gym_primary_dark</item>
        <item name="android:windowBackground">@color/gym_background</item>
        <item name="materialButtonStyle">@style/Widget.Gymly.Button</item>
    </style>

    <style name="Theme.Gymly.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/gym_primary_dark</item>
        <item name="android:navigationBarColor">@color/gym_primary_dark</item>
        <item name="android:windowBackground">@color/gym_primary</item>
    </style>

</resources>
